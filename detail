<!doctype html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TPN Order Report | Srinagarind Hospital</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { font-family: 'Sarabun', sans-serif; color: #000; line-height: 1.2; }
    body { background-color: #f3f4f6; padding: 0; margin: 0; }
    
    /* บังคับพิมพ์ 1 หน้า A4 */
    @media print {
      @page { size: A4; margin: 8mm; }
      body { background-color: white; padding: 0; }
      .no-print { display: none !important; }
      .print-container { border: none !important; width: 100% !important; margin: 0 !important; padding: 0 !important; box-shadow: none !important; }
      table { page-break-inside: auto; }
      tr { page-break-inside: avoid; page-break-after: auto; }
    }

    .print-container { width: 210mm; min-height: 297mm; margin: 10px auto; background: white; padding: 12mm; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
    table { width: 100%; border-collapse: collapse; margin-top: 5px; }
    th, td { border: 1px solid #000; padding: 3px 6px; font-size: 11px; }
    th { background-color: #f2f2f2; font-weight: 800; text-transform: uppercase; }
    .section-title { background-color: #eee; border: 1px solid #000; padding: 2px 8px; font-weight: 800; font-size: 12px; margin-top: 8px; }
  </style>
</head>
<body>

  <div class="max-w-[210mm] mx-auto my-4 flex justify-between no-print px-4">
    <button onclick="window.close()" class="font-bold text-gray-500 hover:text-black">← ปิดหน้าต่าง</button>
    <button onclick="window.print()" class="bg-blue-600 text-white px-8 py-2 rounded-full font-black shadow-lg hover:bg-blue-700">🖨️ พิมพ์รายงาน (A4)</button>
  </div>

  <div class="print-container">
    
    <div class="flex justify-between items-start border-b-2 border-black pb-2 mb-4">
      <div>
        <h1 class="text-xl font-extrabold uppercase tracking-tighter">TPN Order Report</h1>
        <p class="text-[12px] font-bold">โรงพยาบาลศรีนครินทร์ คณะแพทยศาสตร์ มหาวิทยาลัยขอนแก่น</p>
      </div>
      <div class="flex gap-2 items-center">
        <div class="text-right border-r-2 border-black pr-3">
            <p class="text-[10px] font-black text-gray-500 uppercase">Order Date</p>
            <p id="pDate" class="text-sm font-black">-</p>
        </div>
        <div class="text-center bg-black text-white px-4 py-1 rounded-lg">
          <p class="text-[9px] font-bold uppercase">Ward</p>
          <p id="pWard" class="text-3xl font-black leading-none">-</p>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-4 gap-x-4 gap-y-1 text-[12px] mb-4">
      <div class="col-span-2 border-b border-gray-300 pb-1"><span class="font-bold">Name:</span> <span id="pName" class="font-black text-sm">-</span></div>
      <div class="border-b border-gray-300 pb-1"><span class="font-bold">HN:</span> <span id="pHN" class="font-black font-mono">-</span></div>
      <div class="border-b border-gray-300 pb-1"><span class="font-bold">Weight:</span> <span id="pBW" class="font-black">-</span> kg</div>
      
      <div class="col-span-1"><span class="font-bold">Route:</span> <span id="pRoute" class="font-black uppercase">-</span></div>
      <div class="col-span-1"><span class="font-bold">PN Vol:</span> <span id="vol-pn" class="font-black">-</span> ml</div>
      <div class="col-span-1"><span class="font-bold">Total Rate:</span> <span id="rate-pn" class="font-black">-</span> ml/hr</div>
      <div class="col-span-1 text-right italic text-[9px] text-gray-400">Gen: <span id="genTime"></span></div>
    </div>

    <div class="section-title">🧪 TPN Composition & Preparation</div>
    <table>
      <thead>
        <tr>
          <th class="text-left">Component</th>
          <th class="w-24">Dosage</th>
          <th class="w-24">Volume (ml)</th>
          <th>Notes / Clinical Info</th>
        </tr>
      </thead>
      <tbody id="compositionTable">
        </tbody>
    </table>

    <div class="section-title">📊 Clinical Summary</div>
    <div class="grid grid-cols-3 gap-2 mt-2 text-center">
      <div class="border border-black p-1 bg-gray-50">
        <p class="text-[9px] font-bold uppercase">Total Calories</p>
        <p id="val-cal" class="text-sm font-black">-</p>
      </div>
      <div class="border border-black p-1 bg-gray-50">
        <p class="text-[9px] font-bold uppercase">Osmolarity</p>
        <p id="val-osmol" class="text-sm font-black">-</p>
      </div>
      <div class="border border-black p-1 bg-gray-50">
        <p class="text-[9px] font-bold uppercase">GIR (mg/kg/min)</p>
        <p id="val-gir" class="text-sm font-black">-</p>
      </div>
    </div>

    <div id="alertBox" class="hidden mt-3 p-2 border-2 border-black bg-gray-100 text-[11px] font-bold italic">
      ⚠️ CLINICAL ALERT: <span id="alertText"></span>
    </div>

    <div class="mt-auto pt-16 grid grid-cols-4 gap-4 text-center">
      <div class="border-t border-black pt-1">
        <p class="text-[10px] font-bold">.............................................</p>
        <p class="text-[9px] font-black uppercase mt-1">Physician</p>
      </div>
      <div class="border-t border-black pt-1">
        <p class="text-[10px] font-bold">.............................................</p>
        <p class="text-[9px] font-black uppercase mt-1">Verified By (Phar)</p>
      </div>
      <div class="border-t border-black pt-1">
        <p class="text-[10px] font-bold">.............................................</p>
        <p class="text-[9px] font-black uppercase mt-1">Prepared By</p>
      </div>
      <div class="border-t border-black pt-1">
        <p class="text-[10px] font-bold">.............................................</p>
        <p class="text-[9px] font-black uppercase mt-1">Dispensed By</p>
      </div>
    </div>

    <p class="text-center text-[8px] mt-6 text-gray-400">Srinagarind Hospital TPN System v2.0 - Srinagarind Hospital, Faculty of Medicine, Khon Kaen University</p>
  </div>

  <script>
    const API_URL = 'https://script.google.com/macros/s/AKfycby5VHSu21HRdyIYzJvrloomNF_zw1LmZA97aDgyfMGrTPMuzwZGdhPdUz0ucNS3RX8D7g/exec';

    document.addEventListener('DOMContentLoaded', fetchOrderDetail);

    async function fetchOrderDetail() {
      const urlParams = new URLSearchParams(window.location.search);
      const row = urlParams.get('row');
      try {
        const res = await fetch(`${API_URL}?action=getData`);
        const data = await res.json();
        const order = data.find(i => i.row_index == row);
        if (order) displayReport(order);
      } catch (e) { console.error(e); }
    }

    function displayReport(o) {
      document.getElementById('pDate').innerText = new Date(o.order_date).toLocaleDateString('th-TH', {day:'2-digit', month:'short', year:'numeric'});
      document.getElementById('pWard').innerText = o.ward || '-';
      document.getElementById('pName').innerText = o.patient_name || 'N/A';
      document.getElementById('pHN').innerText = o.hn || '-';
      document.getElementById('pBW').innerText = o.bw || '-';
      document.getElementById('pRoute').innerText = o.route || '-';
      document.getElementById('vol-pn').innerText = o.pn_volume || '0';
      document.getElementById('rate-pn').innerText = o.rate_tpn || '0';
      document.getElementById('genTime').innerText = new Date().toLocaleString('th-TH', {dateStyle:'short', timeStyle:'short'});

      // Summary
      document.getElementById('val-cal').innerText = (o.total_calories || 0) + ' kcal';
      document.getElementById('val-osmol').innerText = (o.osmolarity || 0) + ' mOsm/L';
      const gir = o.bw > 0 ? ((o.rate_tpn * o.dextrose_percent) / (o.bw * 6)).toFixed(1) : 0;
      document.getElementById('val-gir').innerText = gir;

      // Table Generation (แสดงทุกรายการ แม้เป็น 0)
      const table = document.getElementById('compositionTable');
      const items = [
        { n: "10% Aminoven® infant", d: `${o.protein_target || 0} g/kg`, v: o.protein_volume || 0, note: "" },
        { n: "50% Dextrose", d: `${o.dextrose_percent || 0} %`, v: o.dextrose_volume || 0, note: `GIR: ${gir}` },
        { n: "20% SMOF Lipid", d: `${o.fat_target || 0} g/kg`, v: o.fat_volume || 0, note: "" },
        { n: "Glycophos® (P)", d: `${o.phosphorus || 0} mmol/kg`, v: o.phosphorus_volume || 0, note: "" },
        { n: "Sodium Chloride (NaCl)", d: `${o.sodium || 0} mEq/kg`, v: o.sodium_volume || 0, note: "" },
        { n: "Potassium Chloride (KCl)", d: `${o.potassium || 0} mEq/kg`, v: o.potassium_volume || 0, note: "" },
        { n: "Calcium Gluconate", d: `${o.calcium || 0} mmol/kg`, v: o.calcium_volume || 0, note: "" },
        { n: "Magnesium Sulfate", d: `${o.magnesium || 0} mmol/kg`, v: o.magnesium_volume || 0, note: "" },
        { n: "Trace Elements (Peditrace)", d: "-", v: o.trace_volume || 0, note: "" },
        { n: "Multivitamin (Cernevit)", d: "-", v: o.vitamin_volume || 0, note: "" },
        { n: "Vitamin K1", d: "-", v: o.vit_k_volume || 0, note: "" },
        { n: "Zinc Sulfate", d: "-", v: o.zinc_volume || 0, note: "" },
        { n: "Heparin", d: "-", v: o.heparin_volume || 0, note: "" },
        { n: "Sterile Water", d: "-", v: o.water_volume || 0, note: "" }
      ];

      table.innerHTML = items.map(i => `
        <tr class="${i.v == 0 ? 'text-gray-400' : ''}">
          <td class="font-bold">${i.n}</td>
          <td class="text-center font-mono">${i.d}</td>
          <td class="text-center font-black">${i.v} ml</td>
          <td class="text-[9px] italic">${i.note}</td>
        </tr>
      `).join('');

      // Clinical Alerts
      if (o.route === 'peripheral' && o.osmolarity > 900) {
        document.getElementById('alertBox').classList.remove('hidden');
        document.getElementById('alertText').innerText = "Osmolarity exceeds safe limit for Peripheral route.";
      }
    }
  </script>
</body>
</html>
